{
  "name": "packing-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
